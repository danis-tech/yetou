# ============================
# Application Next.js
# ============================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# API Django — appels directs depuis le navigateur (CORS configuré côté Django)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
# URL Django absolue (OAuth Google, redirections)
NEXT_PUBLIC_DJANGO_URL=http://127.0.0.1:8000
# URL Django pour les Route Handlers serveur
DJANGO_BACKEND_URL=http://127.0.0.1:8000

# ============================
# Paiement : MyPVit, entièrement géré par Django (voir yetoupxback/.env.example).
# Aucun secret de paiement ne doit être défini côté Next.js.
# ============================

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=yetou-media
CLOUDFLARE_R2_PUBLIC_URL=
