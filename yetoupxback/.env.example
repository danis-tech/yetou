# ─── Django ───
# DEBUG=False en production. DJANGO_SECRET_KEY est obligatoire dès que DEBUG=False :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DEBUG=True
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Production derrière nginx / reverse proxy HTTPS :
# TRUST_X_FORWARDED_FOR=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# ─── PostgreSQL ───
DB_NAME=yetou
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ─── Cloudflare R2 ───
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
CF_ACCOUNT_ID=
R2_PUBLIC_DOMAIN=

# ─── Google OAuth ───
GOOGLE_ID_CLIENT=
GOOGLE_SECRET_CLIENT=

# ─── MyPVit (docs.mypvit.pro) ───
# Menu Comptes : codes des comptes d'opération (ACC_...). Les comptes par opérateur
# sont optionnels (repli sur MYPVIT_ACCOUNT_CODE).
MYPVIT_BASE_URL=https://api.mypvit.pro/v2
MYPVIT_ACCOUNT_CODE=
MYPVIT_ACCOUNT_CODE_MOOV=
MYPVIT_ACCOUNT_CODE_AIRTEL=
MYPVIT_ACCOUNT_CODE_VISA_MASTERCARD=
MYPVIT_API_PASSWORD=
# Menu APIs : « codes URL » de chaque API.
MYPVIT_CODE_URL_SECRET=
MYPVIT_CODE_URL_PAYMENT=
MYPVIT_CODE_URL_STATUS=
MYPVIT_CODE_URL_KYC=
MYPVIT_CODE_URL_LINK=
# Menu Urls : callback → https://<backend>/api/payments/webhook/mypvit/
MYPVIT_CALLBACK_URL_CODE=
# Menu Urls (type Redirection) → https://<frontend>/paiement/retour?status=success
#                               → https://<frontend>/paiement/retour?status=error
MYPVIT_SUCCESS_REDIRECTION_URL_CODE=
MYPVIT_FAILED_REDIRECTION_URL_CODE=
# IP sortantes de MyPVit (à demander à leur support), séparées par des virgules.
# Recommandé : sans elles, un webhook dont MyPVit ne retrouve pas la transaction
# reste en attente et doit être confirmé à la main depuis l'admin.
MYPVIT_WEBHOOK_ALLOWED_IPS=
